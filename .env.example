# Copy to .env and fill in real values.

# ── Public origin ──────────────────────────────────────────────────────────
# REQUIRED in production. Every absolute URL in the product derives from it:
# per-page canonicals, sitemap.xml entries, the robots host, every link inside
# llms.txt, Open Graph images, and the public micro-site URLs you hand to
# prospects. If it is unset the site still builds, but all of those point at
# localhost and the whole SEO/AEO surface is wrong — silently, because a
# well-formed wrong URL is still a valid string.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
# Optional ad-attribution tags. All load ONLY after the visitor accepts
# optional analytics in the cookie banner.
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""       # GA4, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=""           # Google Ads, e.g. AW-XXXXXXXXXX

# ── Database (Supabase / Neon) ─────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string → URI.
#
# Port 5432 on the pooler host is SESSION mode (one Postgres session per
# connection). Transaction mode is a different port, 6543, and it hands the
# server back to the pool at the end of each transaction — so session-level SET,
# advisory locks and LISTEN do not survive. They are not interchangeable; pick the
# one your connection string actually names.
#
# Session mode is the right default here. `lib/db.ts` only rewrites a direct
# `db.<ref>.supabase.co` URL on Vercel, because that host is IPv6-only and Vercel
# has no IPv6 egress; the pooler is IPv4 in both modes, so the rewrite needs
# nothing from transaction mode. Transaction mode is the better choice for
# minimising connection count under serverless load, at the cost of the session
# semantics above.
#
# If you paste the *direct* (non-pooler) URL instead, the rewrite handles it on
# Vercel and leaves it alone everywhere else.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Optional. Only read when DATABASE_URL uses the direct db.<ref>.supabase.co host.
# SUPABASE_POOLER_MODE="transaction"   # 6543 instead of the 5432 default
# SUPABASE_POOLER_HOST="aws-0-ap-south-1.pooler.supabase.com"
# SUPABASE_POOLER_PORT="5432"

# ── Auth (NextAuth v5) ─────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Local dev only. In production leave AUTH_URL unset (or set it to the deployed
# origin) — a loopback value forces auth redirects to http://localhost:3000.
AUTH_URL=http://localhost:3000

# Public origin of this app. Used to build the WhatsApp webhook URL shown in
# Settings → WhatsApp, so it must be the exact URL Meta can reach.
APP_URL="http://localhost:3000"

# ── Google OAuth (optional) ────────────────────────────────────────────────
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── PDF rendering (documents + reports) ────────────────────────────────────
# Local dev: path to an installed Chrome/Edge used to render PDFs. If Chrome is
# in a standard location it is auto-detected and this can stay blank.
# On Vercel, @sparticuz/chromium is used automatically — no value needed.
# Windows example: C:/Program Files/Google/Chrome/Application/chrome.exe
PUPPETEER_EXECUTABLE_PATH=""

# ── Social token vault ─────────────────────────────────────────────────────
# Encrypts access/refresh tokens at rest (AES-256-GCM). Required.
# If unset the app falls back to AUTH_SECRET, which means ROTATING AUTH_SECRET
# silently destroys every stored connection. Set a dedicated, backed-up key:
#   openssl rand -base64 32
SOCIAL_TOKEN_KEY=""

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────────────────
# WhatsApp is the only connected messaging channel in this build.
#
# MASTER SWITCH. The integration is PARKED by default — every entry point
# (settings UI, inbound webhook, drain cron, outbound send, connection actions)
# is disabled unless this is explicitly truthy. Set to "true" to turn it back on.
WHATSAPP_ENABLED="false"
#
# Setup: developers.facebook.com → create app → add the "WhatsApp" product.
# Use the free Test WhatsApp Business System User to get a permanent token.
#
# Required to SEND messages:
# System User access token for the WhatsApp Business Account.
WHATSAPP_TOKEN=""
# Found in WhatsApp → API Setup → "Phone number ID" (numeric, not the number).
WHATSAPP_PHONE_NUMBER_ID=""
# The WhatsApp Business Account id (API Setup → "WhatsApp Business Account ID").
# Needed to list numbers during OAuth linking and to scope webhook subscriptions.
# Accepts WHATSAPP_WABA_ID or WHATSAPP_BUSINESS_ACCOUNT_ID.
WHATSAPP_WABA_ID=""

# Required to RECEIVE messages (the webhook must be verifiable, or inbound is rejected):
# App secret: WhatsApp → API Setup → "App secret". Verifies X-Hub-Signature-256.
WHATSAPP_APP_SECRET=""
# Any random string you choose; you paste the same value into Meta's webhook
# "Verify token" field. Without it, the GET handshake and all POSTs fail closed.
WHATSAPP_VERIFY_TOKEN=""

# Required only for OAuth account linking (Connect another WABA) and for
# registering the app-level webhook subscription programmatically.
WHATSAPP_APP_ID=""

# Optional overrides:
# Graph API version pin. Defaults to v23.0.
WHATSAPP_GRAPH_VERSION=""
# Where to send OAuth/webhook callbacks. Defaults to AUTH_URL.
WHATSAPP_REDIRECT_URI=""
# Fallback tenant for inbound messages that cannot be routed to any workspace
# (shared-number setups). Leave blank in production; without it, unmatched
# messages are parked for review rather than guessed into a tenant.
WHATSAPP_DEFAULT_WORKSPACE=""
# Set to "false" to disable Meta's 24-hour reply-window gate (testing only).
# In production the window is always enforced because Meta rejects outside it.
WHATSAPP_ENFORCE_REPLY_WINDOW=""
# Allow simulated sends outside production. Mock messages are visibly labelled
# "not sent (mock)" in the inbox and are never available in production.
WHATSAPP_ALLOW_MOCK=""

# ── Cron protection ────────────────────────────────────────────────────────
# Bearer token for /api/cron/* (WhatsApp webhook drain). Required in production:
# without it those endpoints refuse to run. Generate: openssl rand -hex 16
CRON_SECRET=""

# ── Worker protection ──────────────────────────────────────────────────────
# Shared secret for /api/worker/* (async lead processing). Required in
# production: without it those endpoints refuse to run.
# Generate: openssl rand -hex 16
WORKER_SECRET="change-me"
