# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and this is the opt-in: .env.example is the setup template the README
# tells you to copy. Ignored, it is unshared — so every machine hand-writes its
# env, which is how NEXT_PUBLIC_SITE_URL ended up unset on every one of them
# and the whole SEO surface pointed at a dead fallback domain.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma
playwright-report/
test-results/
.claude/
.md
.agents/
# Superpowers brainstorm scratch (visual companion mockups)
.superpowers/
.playwright-mcp/
