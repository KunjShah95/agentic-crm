// Agentic CRM — Phase 1 data model
// Prisma 7 (prisma-client generator, driver adapters)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum ActivityType {
  NOTE
  EMAIL
  CALL
  MEETING
  TASK
}

enum UnitStatus {
  AVAILABLE
  HOLD
  BOOKED
  SOLD
}

enum UnitConfig {
  BHK1
  BHK2
  BHK3
  BHK4
  VILLA
  PLOT
  SHOP
  OFFICE
}

enum DocumentKind {
  DEMAND_LETTER
  ALLOTMENT
  BOOKING_FORM
  RECEIPT
  POSSESSION
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("free")
  createdAt DateTime @default(now())
  settingsJson Json?

  members           WorkspaceMember[]
  invites           WorkspaceInvite[]
  contacts          Contact[]
  deals             Deal[]
  orgs              Organization[]
  stages            PipelineStage[]
  activities        Activity[]
  tags              Tag[]
  subscription      Subscription?
  socialConnections SocialConnection[]
  socialEvents      SocialEvent[]
  usageEvents       UsageEvent[]
  usageCounters     UsageCounter[]
  projects          Project[]
  units             Unit[]
  costSheets        CostSheet[]
  payments          Payment[]
  documentTemplates DocumentTemplate[]
  generatedDocuments GeneratedDocument[]
  webhookEvents     WebhookEvent[]
  auditLogs         AuditLog[]

  @@index([slug])
}

model Subscription {
  id               String    @id @default(cuid())
  workspaceId      String    @unique
  stripeCustomerId String    @unique
  stripeSubId      String?   @unique
  plan             String
  status           String
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status])
}

model PlanLimits {
  plan              String @id
  maxSeats          Int
  maxContacts       Int
  maxSocialAccounts Int
  msgPerMonth       Int
  webhookPerDay     Int
  agentCreditsPerMo Int      @default(0)
}

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  reraNo      String?
  address     String?
  city        String   @default("Ahmedabad")
  type        String   @default("RESIDENTIAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  towers      Tower[]
  units       Unit[]
  plans       PaymentPlan[]
  @@index([workspaceId])
  @@unique([workspaceId, name])
}

model Tower {
  id        String   @id @default(cuid())
  projectId String
  name      String
  floors    Int      @default(10)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floorsRel Floor[]
  @@index([projectId])
}

model Floor {
  id      String @id @default(cuid())
  towerId String
  number  Int
  tower   Tower  @relation(fields: [towerId], references: [id], onDelete: Cascade)
  units   Unit[]
  @@unique([towerId, number])
}

model Unit {
  id         String     @id @default(cuid())
  workspaceId String
  projectId  String
  floorId    String?
  unitNo     String
  config     UnitConfig @default(BHK2)
  area       Float?
  carpetArea Float?
  builtUp    Float?
  facing     String?
  price      Float?
  status     UnitStatus @default(AVAILABLE)
  holdUntil  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floor      Floor?    @relation(fields: [floorId], references: [id], onDelete: SetNull)
  costSheets CostSheet[]
  deals      Deal[]
  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
  @@unique([projectId, unitNo])
}

model CostSheet {
  id           String   @id @default(cuid())
  workspaceId  String
  unitId       String
  dealId       String?
  version      Int      @default(1)
  basePrice    Float
  gst          Float    @default(0)
  stampDuty    Float    @default(0)
  otherCharges Json?
  total        Float
  currency     String   @default("INR")
  createdAt    DateTime @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  deal         Deal?    @relation("CostSheetDeal", fields: [dealId], references: [id], onDelete: SetNull)
  dealsViaCostSheet Deal[] @relation("DealCostSheet")
  @@index([workspaceId])
  @@index([unitId])
}

model PaymentPlan {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestones  PaymentMilestone[]
  deals       Deal[]
  @@index([projectId])
}
model PaymentMilestone {
  id       String @id @default(cuid())
  planId   String
  label    String
  pct      Float
  order    Int
  plan     PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@index([planId])
}
model Payment {
  id          String   @id @default(cuid())
  workspaceId String
  dealId      String
  milestoneId String?
  amount      Float
  dueDate     DateTime?
  status      String   @default("DUE")
  receiptNo   String?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
  @@index([dealId])
}
model DocumentTemplate {
  id          String       @id @default(cuid())
  workspaceId String
  kind        DocumentKind
  name        String
  bodyHtml    String
  reraAligned Boolean @default(true)
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generatedDocuments GeneratedDocument[]
  @@index([workspaceId, kind])
}
model GeneratedDocument {
  id          String   @id @default(cuid())
  workspaceId String
  dealId      String?
  unitId      String?
  templateId  String
  renderedHtml String
  pdfUrl      String?
  eSignStatus String   @default("PENDING")
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template    DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  @@index([workspaceId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  workspaceId String?
  source      String
  payload     Json
  dedupeKey   String    @unique
  status      String    @default("PENDING")
  error       String?
  attempts    Int       @default(0)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, source])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entity      String
  entityId    String?
  meta        Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entity])
  @@index([createdAt])
}

model SocialConnection {
  id                String    @id @default(cuid())
  workspaceId       String
  provider          String
  externalAccountId String
  displayName       String?
  accessTokenEnc    String
  refreshTokenEnc   String?
  expiresAt         DateTime?
  status            String    @default("active")
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, externalAccountId])
  @@index([provider, status])
}

model SocialEvent {
  id          String    @id
  workspaceId String
  provider    String
  type        String
  payload     Json
  dedupeKey   String    @unique
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@index([workspaceId, provider])
}

model UsageEvent {
  id          String   @id @default(cuid())
  workspaceId String
  kind        String
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  meta        Json?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind, createdAt])
}

model UsageCounter {
  workspaceId String
  kind        String
  period      String
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, kind, period])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  passwordHash String?
  avatarUrl String?
  createdAt DateTime @default(now())

  memberships   WorkspaceMember[]
  ownedContacts Contact[]
  ownedDeals    Deal[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        Role
  token       String   @unique
  expiresAt   DateTime
  accepted    Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

model Contact {
  id             String   @id @default(cuid())
  workspaceId    String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  linkedinUrl    String?
  jobTitle       String?
  organizationId String?
  ownerId        String?
  handles        Json?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  leadSource     String?
  leadScore      Int?
  requirementsJson Json?
  kycJson        Json?
  consentAt      DateTime?
  optedOut      Boolean  @default(false)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner        User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deals        Deal[]
  activities   Activity[]
  tags         ContactTag[]

  @@index([workspaceId])
  @@index([organizationId])
  @@index([ownerId])
  @@index([email])
  @@index([createdAt])
}

model Organization {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  domain      String?
  industry    String?
  size        String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  Contact[]
  deals     Deal[]

  @@index([workspaceId])
  @@index([domain])
}

model PipelineStage {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  order       Int
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deals     Deal[]

  @@index([workspaceId])
  @@unique([workspaceId, order])
}

model Deal {
  id                String    @id @default(cuid())
  workspaceId       String
  title             String
  contactId         String?
  organizationId    String?
  stageId           String
  value             Float?
  currency          String    @default("USD")
  probability       Int?
  expectedCloseDate DateTime?
  ownerId           String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  unitId            String?
  paymentPlanId     String?
  bookingStage      String?
  costSheetId       String?

  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  stage        PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  activities   Activity[]
  tags         DealTag[]
  unit         Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  paymentPlan  PaymentPlan?  @relation(fields: [paymentPlanId], references: [id], onDelete: SetNull)
  costSheet    CostSheet?    @relation("DealCostSheet", fields: [costSheetId], references: [id], onDelete: SetNull)
  payments     Payment[]
  costSheetsAsDeal CostSheet[] @relation("CostSheetDeal")

  @@index([workspaceId])
  @@index([stageId])
  @@index([contactId])
  @@index([ownerId])
  @@index([createdAt])
}

model Activity {
  id            String       @id @default(cuid())
  workspaceId   String
  type          ActivityType
  contactId     String?
  dealId        String?
  body          String?
  scheduledAt   DateTime?
  completedAt   DateTime?
  assigneeId    String?
  source        String       @default("manual")
  socialEventId String?
  createdBy     String
  createdAt     DateTime     @default(now())
  channel       String?
  templateId    String?
  direction     String?

  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialEvent SocialEvent? @relation(fields: [socialEventId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([contactId])
  @@index([dealId])
  @@index([assigneeId])
  @@index([createdAt])
  @@index([source])
  @@index([socialEventId])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#64748b")
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  ContactTag[]
  deals     DealTag[]

  @@index([workspaceId])
}

model ContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model DealTag {
  dealId String
  tagId  String
  createdAt DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dealId, tagId])
}
